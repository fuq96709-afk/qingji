<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <service android:name="expo.modules.qingjinotifications.PaymentScreenService"
      android:label="轻记 · 支付页面识别"
      android:exported="true"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data android:name="android.accessibilityservice" android:resource="@xml/qingji_payment_screen_service" />
    </service>
    <service android:name="expo.modules.qingjinotifications.PaymentNoticeListener"
      android:label="轻记 · 消费通知识别"
      android:exported="false"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
  </application>
</manifest>
