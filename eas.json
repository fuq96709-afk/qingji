{
  "build": {
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":qingji-notifications:testReleaseUnitTest :app:assembleRelease",
        "autoIncrement": "versionCode"
      },
      "developmentClient": false
    },
    "production": {
      "environment": "production"
    },
    "android-universal": {
      "extends": "preview",
      "android": {
        "gradleCommand": ":qingji-notifications:testReleaseUnitTest :app:assembleRelease -PreactNativeArchitectures=armeabi-v7a,arm64-v8a,x86,x86_64"
      }
    }
  },
  "cli": {
    "appVersionSource": "local"
  }
}
